{
  "name": "apolog",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names convex,web --prefix-colors magenta,cyan \"bun run dev:convex\" \"bun run dev:web\"",
    "dev:convex": "bunx convex dev",
    "dev:web": "bun --env-file=../../.env --cwd=apps/web run dev",
    "build": "dotenv -e .env -- turbo run build",
    "images:generate": "bun scripts/generate-hero-mobile.mjs",
    "icons:generate": "bun scripts/generate-icons.mjs",
    "test": "bun test",
    "perf:javascript": "bun scripts/measure-page-javascript.ts",
    "contradictions:verify-assessments": "bun packages/backend/scripts/verify-contradiction-assessments.ts",
    "typecheck": "turbo run typecheck",
    "lint": "bun run lint:ox && bun run format:check",
    "lint:ox": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "react:doctor": "react-doctor . --yes --no-score --no-cache --blocking warning",
    "knip": "knip --no-progress",
    "deps:check": "bun run scripts/dependency-policy.ts",
    "check": "bun run lint && bun run react:doctor && bun run knip && bun test && bun run deps:check && bun run typecheck",
    "convex:deploy": "bunx convex deploy",
    "convex:seed": "bunx convex run seed:seed",
    "contradictions:refresh": "bun apps/ingest/src/refresh-contradictions.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "1.4.2",
    "concurrently": "10.0.5",
    "convex": "1.46.0",
    "dotenv-cli": "11.0.0",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "react-doctor": "0.9.16",
    "sharp": "0.35.5",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.3.13"
}
